# JEET AI Tutor - Environment Variables (FULL INTERNET MODE)
# Copy this file to .env OR .env.local in the project root and fill in your keys
# The app reads GEMINI_API_KEY from process.env on the server - no need for Settings modal if you use this.

# 1. Gemini API Key - get FREE from https://aistudio.google.com/app/apikey
#    Pasted here, your app uses FULL INTERNET for every lesson/quiz (no mock limit).
#    You can also paste the same key in the UI: Settings (⚙️ top-right) -> Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Optional: OpenAI fallback (if Gemini quota hits)
OPENAI_API_KEY=your_openai_api_key_here

# 3. App branding (you chose to keep JEET AI Personal)
NEXT_PUBLIC_APP_NAME="JEET AI - Personal Tutor"

# NOTE: .env is ignored by git (.gitignore) - never committed. Put your real key here, restart `npm run dev`.
